generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model assessors {
  id                  Int                   @id @default(autoincrement())
  title               String?               @db.VarChar(20)
  name                String                @db.VarChar(100)
  email               String                @unique @db.VarChar(100)
  expertise           String?
  research_interests  String?
  assigned_count      Int                   @default(0)
  preferred_slots     Int                   @default(3)
  student_fyp_records student_fyp_records[]
  viva_availabilities viva_availabilities[]
  viva_schedules      viva_schedules[]
}

model batches {
  id                  Int                   @id @default(autoincrement())
  batch_code          String                @unique @db.VarChar(20)
  batch_intake        String                @db.VarChar(50)
  start_fyp_date      DateTime              @db.Date
  stage               String?               @default("Proposal") @db.VarChar(20)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  students            students[]
  viva_period_batches viva_period_batches[]
  milestones          milestones[]
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  title      String?   @db.VarChar(255)
  message    String?
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model proposal_requests {
  id                Int       @id @default(autoincrement())
  student_id        Int?
  supervisor_id     Int?
  proposed_topic    String?
  proposal_pdf      String?
  status            String?   @default("Pending")
  rejection_reason  String?
  submitted_at      DateTime? @default(now())
  approved_at       DateTime?
  student_confirmed Boolean   @default(false)

  students    students?    @relation(fields: [student_id], references: [id])
  supervisors supervisors? @relation(fields: [supervisor_id], references: [id])
}

model student_fyp_records {
  id                             Int          @id @default(autoincrement())
  student_id                     Int?
  tentative_topic                String?
  supervisor_id                  Int?
  supervisor_confirmation_status String?      @default("Pending") @db.VarChar(30)
  assessor_id                    Int?
  assessors                      assessors?   @relation(fields: [assessor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  students                       students?    @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supervisors                    supervisors? @relation(fields: [supervisor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model students {
  id                       Int                        @id @default(autoincrement())
  batch_id                 Int?
  student_name             String                     @db.VarChar(100)
  cb_no                    String                     @unique @db.VarChar(20)
  logsheets                logsheets[]
  proposal_requests        proposal_requests[]
  student_fyp_records      student_fyp_records[]
  batches                  batches?                   @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viva_availabilities      viva_availabilities[]
  viva_schedules           viva_schedules[]
  studentMilestoneStatuses student_milestone_status[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model supervisors {
  id                          Int                   @id @default(autoincrement())
  title                       String?               @db.VarChar(20)
  name                        String                @db.VarChar(100)
  email                       String                @unique @db.VarChar(100)
  expertise                   String?
  research_interests          String?
  additional_information      String?
  preferred_supervision_slots Int                   @default(3)
  signature_url               String?
  logsheets                   logsheets[]
  proposal_requests           proposal_requests[]
  student_fyp_records         student_fyp_records[]
  viva_availabilities         viva_availabilities[]
  viva_schedules              viva_schedules[]
}

model templates {
  id          Int      @id @default(autoincrement())
  title       String
  file_path   String
  uploaded_at DateTime @default(now())
  file_name   String
  file_size   String
  file_type   String
  stage       String   @default("Proposal")
}

model users {
  id            Int             @id @default(autoincrement())
  name          String?         @db.VarChar(100)
  email         String          @unique @db.VarChar(150)
  password      String?         @db.VarChar(255)
  role          String          @db.VarChar(20)
  is_active     Boolean?        @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  notifications notifications[]
}

model logsheets {
  id                Int          @id @default(autoincrement())
  student_id        Int
  supervisor_id     Int?
  meeting_date      DateTime
  venue             String?
  file_name         String
  file_path         String
  file_type         String?
  file_size         String?
  status            String       @default("Pending Review")
  semester          String
  rejection_reason  String?
  approved_at       DateTime?
  rejected_at       DateTime?
  signature_applied Boolean      @default(false)
  signed_file_url   String?
  created_at        DateTime     @default(now())
  students          students     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  supervisors       supervisors? @relation(fields: [supervisor_id], references: [id])
}

model external_supervisor_requests {
  id                          Int       @id @default(autoincrement())
  title                       String?   @db.VarChar(20)
  name                        String    @db.VarChar(100)
  email                       String    @unique @db.VarChar(100)
  university                  String    @db.VarChar(150)
  expertise                   String?
  research_interests          String?
  preferred_supervision_slots Int       @default(3)
  status                      String    @default("Pending")
  rejection_reason            String?
  approved_at                 DateTime?
  approved_by                 String?
  created_at                  DateTime  @default(now())
}

model viva_periods {
  id               Int       @id @default(autoincrement())
  name             String?   @db.VarChar(150)
  type             String    @db.VarChar(50)
  intake           String?   @db.VarChar(50)
  academic_year    String?   @db.VarChar(20)
  semester         String?   @db.VarChar(20)
  start_date       DateTime  @db.Date
  end_date         DateTime  @db.Date
  daily_start_time String?   @db.VarChar(10)
  daily_end_time   String?   @db.VarChar(10)
  slot_duration    Int       @default(30)
  status           String    @default("DRAFT") @db.VarChar(30)
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  viva_period_batches viva_period_batches[]
  viva_availabilities viva_availabilities[]
  viva_schedules      viva_schedules[]
  viva_audit_logs     viva_audit_logs[]
}

model viva_period_batches {
  viva_period_id Int
  batch_id       Int

  viva_periods viva_periods @relation(fields: [viva_period_id], references: [id], onDelete: Cascade)
  batches      batches      @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@id([viva_period_id, batch_id])
}

model viva_availabilities {
  id             Int       @id @default(autoincrement())
  viva_period_id Int
  supervisor_id  Int?
  assessor_id    Int?
  student_id     Int?
  date           DateTime  @db.Date
  start_time     DateTime  @db.Time(6)
  end_time       DateTime  @db.Time(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  viva_period viva_periods @relation(fields: [viva_period_id], references: [id], onDelete: Cascade)
  supervisors supervisors? @relation(fields: [supervisor_id], references: [id], onDelete: Cascade)
  assessors   assessors?   @relation(fields: [assessor_id], references: [id], onDelete: Cascade)
  students    students?    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([viva_period_id])
  @@index([date])
}

model viva_schedules {
  id                  Int       @id @default(autoincrement())
  viva_period_id      Int
  student_id          Int
  supervisor_id       Int?
  assessor_id         Int?
  batch_code          String?   @db.VarChar(50)
  date                DateTime? @db.Date
  start_time          DateTime? @db.Time(6)
  end_time            DateTime? @db.Time(6)
  duration_mins       Int       @default(30)
  mode                String?   @db.VarChar(20)
  attendance_mode     String?   @default("PHYSICAL") @db.VarChar(20)
  venue               String?   @default("TBA") @db.VarChar(100)
  report_link         String?   @db.Text
  teams_meeting_id    String?   @db.VarChar(255)
  teams_join_url      String?   @db.Text
  outlook_event_id    String?   @db.VarChar(255)
  outlook_sync_status String?   @default("NOT_SYNCED") @db.VarChar(30)
  outlook_sync_error  String?   @db.Text
  status              String    @default("PENDING") @db.VarChar(30)
  finalized_at        DateTime?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @updatedAt

  viva_periods         viva_periods           @relation(fields: [viva_period_id], references: [id], onDelete: Cascade)
  students             students               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  supervisors          supervisors?           @relation(fields: [supervisor_id], references: [id], onDelete: Cascade)
  assessors            assessors?             @relation(fields: [assessor_id], references: [id], onDelete: Cascade)
  viva_confirmations   viva_confirmations[]
  viva_change_requests viva_change_requests[]
  viva_notes           viva_notes[]
  viva_audit_logs      viva_audit_logs[]
}

model viva_confirmations {
  id               Int       @id @default(autoincrement())
  viva_schedule_id Int
  user_id          Int?
  role             String    @db.VarChar(30)
  status           String    @default("PENDING") @db.VarChar(30)
  attendance_mode  String?   @db.VarChar(20)
  comment          String?   @db.Text
  confirmed_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  viva_schedules viva_schedules @relation(fields: [viva_schedule_id], references: [id], onDelete: Cascade)

  @@index([viva_schedule_id])
}

model viva_change_requests {
  id               Int       @id @default(autoincrement())
  viva_schedule_id Int
  requested_by     Int?
  role             String    @db.VarChar(30)
  original_date    DateTime? @db.Date
  original_time    String?   @db.VarChar(20)
  proposed_date    DateTime? @db.Date
  proposed_time    String?   @db.VarChar(20)
  attendance_mode  String?   @db.VarChar(20)
  reason           String?   @db.Text
  admin_response   String?   @db.Text
  status           String    @default("PENDING") @db.VarChar(30)
  created_at       DateTime  @default(now())
  resolved_at      DateTime?

  viva_schedules viva_schedules @relation(fields: [viva_schedule_id], references: [id], onDelete: Cascade)

  @@index([viva_schedule_id])
}

model viva_notes {
  id               Int      @id @default(autoincrement())
  viva_schedule_id Int
  user_id          Int?
  role             String   @db.VarChar(30)
  note             String   @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  viva_schedules viva_schedules @relation(fields: [viva_schedule_id], references: [id], onDelete: Cascade)

  @@index([viva_schedule_id])
}

model viva_audit_logs {
  id               Int       @id @default(autoincrement())
  viva_period_id   Int?
  viva_schedule_id Int?
  action           String    @db.VarChar(100)
  performed_by     String?   @db.VarChar(100)
  role             String?   @db.VarChar(30)
  details          String?   @db.Text
  created_at       DateTime  @default(now())

  viva_periods   viva_periods?   @relation(fields: [viva_period_id], references: [id], onDelete: Cascade)
  viva_schedules viva_schedules? @relation(fields: [viva_schedule_id], references: [id], onDelete: Cascade)
}

model microsoft_integrations {
  id            Int       @id @default(autoincrement())
  admin_email   String    @unique @db.VarChar(150)
  access_token  String?   @db.Text
  refresh_token String?   @db.Text
  token_expiry  DateTime?
  calendar_id   String?   @db.VarChar(255)
  calendar_name String?   @db.VarChar(150)
  is_connected  Boolean   @default(false)
  updated_at    DateTime  @default(now()) @updatedAt
}

model milestones {
  id          Int      @id @default(autoincrement())
  batch_id    Int
  name        String   @db.VarChar(255)
  description String?
  type        String   @db.VarChar(50) // "FORMATIVE" or "SUMMATIVE"
  deadline    DateTime // Includes specific time
  order_index Int      @default(0) // Order sequence
  created_at  DateTime @default(now())

  batches                  batches                    @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student_milestone_status student_milestone_status[]
}

model student_milestone_status {
  id           Int       @id @default(autoincrement())
  student_id   Int
  milestone_id Int
  status       String    @default("Upcoming") @db.VarChar(50) // e.g. "Upcoming", "Submitted", "Overdue", "Graded"
  submitted_at DateTime?
  updated_at   DateTime  @default(now()) @updatedAt

  students   students   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  milestones milestones @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@unique([student_id, milestone_id])
}

model sent_reminders {
  id            Int      @id @default(autoincrement())
  student_id    Int
  milestone_id  Int
  reminder_type String   @db.VarChar(50) // e.g. "1_DAY", "4_WEEKS"
  sent_at       DateTime @default(now())

  @@unique([student_id, milestone_id, reminder_type])
}
